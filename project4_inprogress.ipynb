    "def plot_particle_position(trajectories, dt, times=[40, 120, 300]):\n",
    "\n",
    "    plt.figure(figsize=(10, 5))\n",
    "\n",
    "    colors = ['tab:blue', 'tab:orange', 'tab:green']\n",
    "\n",
    "    for t, color in zip(times, colors):\n",
    "\n",
    "        step = int(t / dt)\n",
    "        positions = trajectories[:, step]\n",
    "\n",
    "        positions = positions[~np.isnan(positions)]\n",
    "        y = np.random.uniform(0, 1, len(positions))\n",
    "\n",
    "        plt.scatter(\n",
    "            positions,\n",
    "            y,\n",
    "            s=2,\n",
    "            alpha=0.4,\n",
    "            color=color,\n",
    "            label=f't = {t} days'\n",
    "        )\n",
    "\n",
    "    plt.axvline(50, color='red', linestyle='--')\n",
    "\n",
    "    plt.xlabel('x [m]')\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
