    "def objective_sa(x):\n",
    "\n",
    "    a, b, v1, v2, v3, alpha_L = x\n",
    "    f1 = a\n",
    "    f2 = (1-a)*b\n",
    "    theta = [f1, f2, v1, v2, v3, alpha_L]\n",
    "\n",
    "    return solver.misfit(\n",
    "        L1, t_data, theta, sigma, C_obs\n",
    "    )"
   ]
  },
