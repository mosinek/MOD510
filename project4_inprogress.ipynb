    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# ============================================================\n",
    "# 1. Reorder best-fit paths so v1 > v2 > v3\n",
    "# ============================================================\n",
    "\n",
    "f1, f2, v1, v2, v3, alpha_L = best_theta\n",
    "\n",
    "fractions = np.array([f1, f2, 1 - f1 - f2])\n",
    "velocities = np.array([v1, v2, v3])\n",
    "\n",
    "order = np.argsort(velocities)[::-1]\n",
    "\n",
    "fractions = fractions[order]\n",
    "velocities = velocities[order]\n",
    "\n",
    "theta0 = np.array([\n",
    "    fractions[0], fractions[1],\n",
    "    velocities[0], velocities[1], velocities[2],\n",
    "    alpha_L\n",
    "])\n",
    "\n",
    "# ============================================================\n",
    "# 2. Log-posterior: -J inside bounds, -inf outside\n",
    "# ============================================================\n",
    "\n",
    "def logpost(theta):\n",
    "\n",
    "    f1, f2, v1, v2, v3, alpha = theta\n",
    "\n",
    "    if not (0 <= f1 and 0 <= f2 and f1 + f2 <= 1):\n",
    "        return -np.inf\n",
    "\n",
    "    if not (0.1 <= v3 < v2 < v1 <= 2):\n",
    "        return -np.inf\n",
    "\n",
    "    if not (0.05 <= alpha <= 5):\n",
    "        return -np.inf\n",
    "\n",
    "    return -solver.misfit(L1, t_data, theta, sigma, C_obs)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. Proposal widths\n",
    "# Use LM standard errors if you have them; otherwise 10% ranges\n",
    "# ============================================================\n",
    "\n",
    "ranges = np.array([1, 1, 1.9, 1.9, 1.9, 4.95])\n",
    "\n",
    "if \"lm_se\" in globals():\n",
    "    widths = 0.5 * np.asarray(lm_se)\n",
    "else:\n",
    "    widths = 0.1 * ranges\n",
    "\n",
    "widths = np.maximum(widths, 1e-6)\n",
    "\n",
    "# ============================================================\n",
    "# 4. Metropolis-Hastings with adaptive burn-in\n",
    "# ============================================================\n",
    "\n",
    "rng = np.random.default_rng(42)\n",
    "\n",
    "burn = 10_000\n",
    "n_steps = 100_000\n",
    "total_steps = burn + n_steps\n",
    "\n",
    "X = theta0.copy()\n",
    "logp = logpost(X)\n",
    "\n",
    "if not np.isfinite(logp):\n",
    "    raise ValueError(\"Starting point is outside the posterior bounds\")\n",
    "\n",
    "chain = np.zeros((total_steps, 6))\n",
    "accepted = 0\n",
    "batch_accepts = 0\n",
    "\n",
    "for k in range(total_steps):\n",
    "\n",
    "    Y = X + widths * rng.normal(size=6)\n",
    "    logp_Y = logpost(Y)\n",
    "\n",
    "    if np.isfinite(logp_Y):\n",
    "\n",
    "        logR = logp_Y - logp\n",
    "\n",
    "        if np.log(rng.uniform()) < min(0, logR):\n",
    "            X = Y\n",
    "            logp = logp_Y\n",
    "            accepted += 1\n",
    "            batch_accepts += 1\n",
    "\n",
    "    chain[k] = X\n",
    "\n",
    "    # Tune proposal widths during burn-in only\n",
    "    if k < burn and (k + 1) % 500 == 0:\n",
    "\n",
    "        rate = batch_accepts / 500\n",
    "\n",
    "        if rate < 0.2:\n",
    "            widths *= 0.8\n",
    "        elif rate > 0.4:\n",
    "            widths *= 1.2\n",
    "\n",
    "        batch_accepts = 0\n",
    "\n",
    "# Production chain\n",
    "samples = chain[burn:]\n",
    "\n",
    "production_acceptance = np.mean(\n",
    "    np.any(np.diff(samples, axis=0) != 0, axis=1)\n",
    ")\n",
    "\n",
    "print(\"Production acceptance rate:\", production_acceptance)\n",
    "print(\"Final proposal widths:\", widths)\n",
    "\n",
    "# ============================================================\n",
    "# 5. Trace plots\n",
    "# ============================================================\n",
    "\n",
    "names = [\"f1\", \"f2\", \"v1\", \"v2\", \"v3\", \"alpha_L\"]\n",
    "\n",
    "fig, axes = plt.subplots(6, 1, figsize=(12, 12), sharex=True)\n",
    "\n",
    "for i, ax in enumerate(axes):\n",
    "    ax.plot(chain[:, i], linewidth=0.4)\n",
    "    ax.axvline(burn, color=\"red\", linestyle=\"--\")\n",
    "    ax.set_ylabel(names[i])\n",
    "    ax.grid(alpha=0.3)\n",
    "\n",
    "axes[-1].set_xlabel(\"Iteration\")\n",
    "plt.suptitle(\"MCMC trace plots (red line = burn-in)\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# ============================================================\n",
    "# 6. Posterior histograms\n",
    "# ============================================================\n",
    "\n",
    "fig, axes = plt.subplots(2, 3, figsize=(12, 7))\n",
    "\n",
    "for i, ax in enumerate(axes.flat):\n",
    "    ax.hist(samples[:, i], bins=40, density=True)\n",
    "    ax.set_xlabel(names[i])\n",
    "    ax.set_ylabel(\"Posterior density\")\n",
    "    ax.grid(alpha=0.3)\n",
    "\n",
    "plt.suptitle(\"Posterior distributions\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# ============================================================\n",
    "# 7. Autocorrelation time and credible intervals\n",
    "# ============================================================\n",
    "\n",
    "def autocorr_time(x):\n",
    "\n",
    "    x = np.asarray(x) - np.mean(x)\n",
    "    n = len(x)\n",
    "\n",
    "    fft = np.fft.fft(x, n=2*n)\n",
    "    acf = np.fft.ifft(fft * np.conjugate(fft)).real[:n]\n",
    "    acf /= acf[0]\n",
    "\n",
    "    # Initial positive sequence\n",
    "    negative = np.where(acf[1:] < 0)[0]\n",
    "    cutoff = negative[0] + 1 if len(negative) else n // 2\n",
    "\n",
    "    return max(1, 1 + 2 * np.sum(acf[1:cutoff]))\n",
    "\n",
    "print(\"\\nPosterior estimates:\")\n",
    "\n",
    "for i, name in enumerate(names):\n",
    "\n",
    "    tau_int = autocorr_time(samples[:, i])\n",
    "    ess = len(samples) / tau_int\n",
    "\n",
    "    median = np.median(samples[:, i])\n",
    "    low, high = np.percentile(samples[:, i], [2.5, 97.5])\n",
    "\n",
    "    print(\n",
    "        f\"{name}: median={median:.4f}, \"\n",
    "        f\"95% CI=[{low:.4f}, {high:.4f}], \"\n",
    "        f\"tau={tau_int:.1f}, ESS={ess:.0f}\"\n",
    "    )"
   ]
