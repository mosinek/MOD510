    "class Solver:\n",
    "    def __init__(self, x0, t0, v=0.5, D=1, alpha_L=2, lamb=0.002, M=1000, L1=50, L2=500):\n",
    "        self.x0 = x0\n",
    "        self.t0 = t0\n",
    "        self.v = v\n",
    "        self.D = D\n",
    "        self.alpha_L = alpha_L\n",
    "        self.lamb = lamb\n",
    "        self.M = M\n",
    "        self.L1 = L1\n",
    "        self.L2 = L2\n",
    "\n",
    "    def random_walk_1d(self, dt, number_of_steps, N = 20000, decay=True):\n",
    "        p_decay = 1 - np.exp(-self.lamb*dt)\n",
    "\n",
    "        trajectories = np.zeros((N, number_of_steps + 1))\n",
    "        trajectories[:, 0] = self.x0\n",
    "        alive = np.ones(N, dtype=bool)\n",
    "\n",
    "        # checkpoint\n",
    "        alive_count = np.zeros(number_of_steps + 1, dtype=int)\n",
    "        alive_count[0] = N\n",
    "\n",
    "        for i in range(number_of_steps):\n",
    "            random_steps = np.random.normal(0, 1, N)\n",
    "            trajectories[alive, i+1] = (trajectories[alive, i] + self.v * dt + np.sqrt(2 * self.D * dt) * random_steps[alive])\n",
    "\n",
    "            if decay:\n",
    "                decay_events = np.random.random(N) < p_decay\n",
    "                alive = alive & ~decay_events\n",
    "            \n",
    "            trajectories[~alive, i+1] = np.nan\n",
    "\n",
    "            alive_count[i+1] = np.sum(alive)\n",
    "            \n",
    "        return trajectories, alive_count\n",
    "\n",
    "    def concentration_profile(self, trajectories, N, dt, time_points, bins=100, x_range=(0, 500)):\n",
    "        profiles = {}\n",
    "\n",
    "        bin_edges = np.linspace(x_range[0], x_range[1], bins+1)\n",
    "        bin_centers = (bin_edges[:-1]  + bin_edges[1:]) / 2\n",
    "        bin_width = bin_edges[1] - bin_edges[0]\n",
    "\n",
    "        for t in time_points:\n",
    "            step = int(t/dt)\n",
    "            positions = trajectories[:, step]\n",
    "            positions = positions[~np.isnan(positions)]\n",
    "\n",
    "            counts, _ = np.histogram(positions, bins=bin_edges)\n",
    "\n",
    "            C = (self.M/N) * counts / bin_width\n",
    "            profiles[t] = C\n",
    "\n",
    "        return bin_centers, profiles\n",
    "\n",
    "    def concentration_ananlytical(self, x, t):\n",
    "        C = (self.M / np.sqrt(4*np.pi*self.D*t)) * np.exp(-((x - self.v*t)**2)/(4*self.D*t) - self.lamb*t)\n",
    "        return C\n",
    "\n",
    "    def first_arrival_times(self, trajectories, dt):\n",
    "        L1 = self.L1\n",
    "\n",
    "        previous = trajectories[:, :-1]\n",
    "        current = trajectories[:, 1:]\n",
    "\n",
    "        crossed = (previous < L1) & (current > L1)\n",
    "        arrived = np.any(crossed, axis=1)\n",
    "        first_cross = np.argmax(crossed, axis=1)\n",
    "\n",
    "        arrival_times = np.full(trajectories.shape[0], np.nan)\n",
    "        arrival_times[arrived] = (first_cross[arrived] + 1) * dt\n",
    "\n",
    "        return arrival_times\n",
    "\n",
    "    def first_arrival_analytical(self, t):\n",
    "        L1 = self.L1\n",
    "        f = L1/(np.sqrt(4*np.pi*self.D*t**3)) * np.exp(-((L1-self.v*t)**2)/(4*self.D*t))\n",
    "        return f\n",
    "\n",
    "    def concentration_tracer(self, L1, t, theta):\n",
    "        f1, f2, v1, v2, v3, alpha_L = theta\n",
    "        f3 = 1-f1-f2\n",
    "        f = [f1, f2, f3]\n",
    "        v = [v1, v2, v3]\n",
    "\n",
    "        C = 0\n",
    "        for i in range(3):\n",
    "            sum = (f[i] * self.M / np.sqrt(4 *np.pi * alpha_L * v[i] *t) * np.exp(-(L1 - v[i] * t)**2 / (4 * alpha_L * v[i] * t)))\n",
    "            C += sum\n",
    "\n",
    "        return C\n",
    "\n",
    "    def misfit(self, L1, t_data, theta, sigma, C_obs):\n",
    "\n",
    "        C_tracer = np.array([self.concentration_tracer(L1, t, theta) for t in t_data])\n",
    "        J = (1 / (2 * sigma**2)) * np.sum((C_tracer - C_obs)**2)\n",
    "        \n",
    "        return J\n",
    "\n",
    "    def local_opt(self, L1, t_data, theta_init, sigma, C_obs):\n",
    "\n",
    "        def residuals(x):\n",
    "\n",
    "            a, b, v1, v2, v3, alpha_L = x\n",
    "            f1 = a\n",
    "            f2 = (1 - a) * b\n",
    "\n",
    "            theta = [f1, f2, v1, v2, v3, alpha_L]\n",
    "            C_tracer = np.array([\n",
    "                self.concentration_tracer(L1, t, theta)\n",
    "                for t in t_data\n",
    "            ])\n",
    "\n",
    "            return (C_tracer - C_obs) / sigma\n",
    "\n",
    "        f1, f2, v1, v2, v3, alpha_L = theta_init\n",
    "        a = f1\n",
    "        b = f2 / (1 - f1) if f1 < 1 else 0\n",
    "        x0 = [a, b, v1, v2, v3, alpha_L]\n",
    "        lower = [0, 0, 0.1, 0.1, 0.1, 0.05]\n",
    "        upper = [1, 1, 2, 2, 2, 5]\n",
    "\n",
    "        opt = least_squares(residuals,x0,bounds=(lower, upper))\n",
    "        a, b, v1, v2, v3, alpha_L = opt.x\n",
    "        f1 = a\n",
    "        f2 = (1-a)*b\n",
    "        theta_opt = [f1,f2,v1,v2,v3,alpha_L]\n",
    "\n",
    "        return theta_opt\n",
    "\n",
    "\n",
    "    def multi_start(self, L1, t_data, sigma, C_obs):\n",
    "\n",
    "        results = []\n",
    "        for i in range(40):\n",
    "            f1 = np.random.uniform(0, 1)\n",
    "            f2 = np.random.uniform(0, 1-f1)\n",
    "            v1 = np.random.uniform(0.1, 2)\n",
    "            v2 = np.random.uniform(0.1, 2)\n",
    "            v3 = np.random.uniform(0.1, 2)\n",
    "            alpha_L = np.random.uniform(0.05, 5)\n",
    "            theta_init = [f1, f2, v1, v2, v3, alpha_L]\n",
    "\n",
    "            theta_opt = self.local_opt(L1, t_data, theta_init, sigma, C_obs)\n",
    "            J = self.misfit(L1, t_data, theta_opt, sigma, C_obs)\n",
    "            results.append((theta_opt, J))\n",
    "\n",
    "        return results\n",
    "\n",
    "    def simulated_annealing(self, f, x0, bounds, T0=1000, T_min=0.5, tau=0.95, \n",
    "                        steps_per_T=100, proposal_width=0.1):\n",
    "        \n",
    "        x = np.array(x0, dtype=float)\n",
    "        lower, upper = np.array(bounds[0]), np.array(bounds[1])\n",
    "        f_x = f(x)\n",
    "\n",
    "        # Initialize the best solution\n",
    "        best_x = x.copy()\n",
    "        best_f = f_x\n",
    "\n",
    "        T = T0\n",
    "        k = 0\n",
    "        # Gaussian proposal standard deviation:\n",
    "        # 10% of the parameter range at T0\n",
    "        proposal_width = 0.1 * (upper - lower)\n",
    "\n",
    "        trace_x = [x.copy()]\n",
    "        trace_f = [f_x]\n",
    "\n",
    "        while T>T_min:\n",
    "            for _ in range(steps_per_T):\n",
    "                sigma = proposal_width * np.sqrt(T / T0)\n",
    "                x_new = x + rng.normal(0, sigma)\n",
    "\n",
    "                # Reject proposals outside the bounds\n",
    "                if np.any(x_new < lower) or np.any(x_new > upper):\n",
    "                    trace_x.append(x.copy())\n",
    "                    trace_f.append(f_x)\n",
    "                    continue\n",
    "\n",
    "                f_new = f(x_new)\n",
    "                dE = f_new - f_x\n",
    "\n",
    "                if dE < 0 or rng.random() < np.exp(-dE/T):\n",
    "                    x, f_x = x_new, f_new\n",
    "\n",
    "                if f_x < best_f:\n",
    "                    best_x, best_f = x.copy(), f_x \n",
    "\n",
    "                trace_x.append(x.copy())\n",
    "                trace_f.append(f_x)\n",
    "\n",
    "            k += 1\n",
    "            T = T0 * np.exp(-k/tau)\n",
    "\n",
    "        return {\n",
    "        \"best_x\": best_x,\n",
    "        \"best_f\": best_f,\n",
    "        \"trace_x\": np.array(trace_x),\n",
    "        \"trace_f\": np.array(trace_f)\n",
    "    }"
   ]
