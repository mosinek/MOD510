    "\n",
    "tau_values = [10, 25, 50, 100, 500, 1000, 2000]\n",
    "\n",
    "n_runs = 40\n",
    "\n",
    "results = {}\n",
    "\n",
    "# Track the absolute best run\n",
    "absolute_best_f = np.inf\n",
    "absolute_best_x = None\n",
    "absolute_best_tau = None\n",
    "absolute_best_run = None\n",
    "\n",
    "for tau in tau_values:\n",
    "\n",
    "    best_misfits = []\n",
    "\n",
    "    for i in range(n_runs):\n",
    "\n",
    "        # Generate a new random starting point\n",
    "        theta_init = np.array([\n",
    "            rng.uniform(0, 1),\n",
    "            rng.uniform(0, 1),\n",
    "            rng.uniform(0.1, 2),\n",
    "            rng.uniform(0.1, 2),\n",
    "            rng.uniform(0.1, 2),\n",
    "            rng.uniform(0.05, 5)\n",
    "        ])\n",
    "\n",
    "        SA = solver.simulated_annealing(\n",
    "            f=objective_sa,\n",
    "            x0=theta_init,\n",
    "            bounds=bounds,\n",
    "            T0=1000,\n",
    "            T_min=0.5,\n",
    "            tau=tau,\n",
    "            steps_per_T=10\n",
    "        )\n",
    "\n",
    "        best_misfits.append(SA[\"best_f\"])\n",
    "\n",
    "        # Check if this is the best run overall\n",
    "        if SA[\"best_f\"] < absolute_best_f:\n",
    "\n",
    "            absolute_best_f = SA[\"best_f\"]\n",
    "            absolute_best_x = SA[\"best_x\"].copy()\n",
    "            absolute_best_tau = tau\n",
    "            absolute_best_run = i + 1\n",
    "\n",
    "    results[tau] = best_misfits\n",
    "\n",
    "    print(f\"\\ntau = {tau}\")\n",
    "    print(f\"Best misfit: {np.min(best_misfits):.4f}\")\n",
    "    print(f\"Mean misfit: {np.mean(best_misfits):.4f}\")\n",
    "    print(f\"Std misfit: {np.std(best_misfits):.4f}\")\n",
    "\n",
    "\n",
    "print(\"BEST RUN:\")\n",
    "print(\"Best misfit:\", absolute_best_f)\n",
    "print(\"Best tau:\", absolute_best_tau)\n",
    "print(\"Run number:\", absolute_best_run)\n",
    "\n",
    "# Convert transformed parameters into physical parameters\n",
    "a, b, v1, v2, v3, alpha_L = absolute_best_x\n",
    "\n",
    "f1 = a\n",
    "f2 = (1-a)*b\n",
    "f3 = (1-a)*(1-b)\n",
    "\n",
    "theta_best = [f1, f2, v1, v2, v3, alpha_L]\n",
    "\n",
    "print(\"\\nBest physical parameters:\")\n",
    "print(\"f1:\", f1)\n",
    "print(\"f2:\", f2)\n",
    "print(\"f3:\", f3)\n",
    "print(\"Sum of fractions:\", f1+f2+f3)\n",
    "print(\"v1:\", v1)\n",
    "print(\"v2:\", v2)\n",
    "print(\"v3:\", v3)\n",
    "print(\"alpha_L:\", alpha_L)\n"
   ]
